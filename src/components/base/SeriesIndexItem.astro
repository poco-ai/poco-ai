---
import Link from '~/components/base/Link.astro'
import { localizeHref } from '~/i18n'

import type { SeriesGroup } from '~/utils/series'

interface Props {
  group: SeriesGroup
  class?: string
}

const { group, class: className } = Astro.props
---

<li class="m-0! p-0!">
  <Link
    href={localizeHref(group.href, Astro.url.pathname)}
    class:list={[
      'flex flex-col items-start gap-0.5 border-b-none! whitespace-normal',
      className,
    ]}
  >
    <span>{group.title}</span>
    {
      group.description && (
        <span class="text-xs leading-snug op-70">{group.description}</span>
      )
    }
    <span class="text-xs leading-snug op-70">{group.posts.length} posts</span>
  </Link>
</li>
