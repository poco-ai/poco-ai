---
import RenderPage from '~/components/views/RenderPage.astro'
import TeamRow from '~/components/views/TeamRow.astro'

import type { Locale } from '~/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<RenderPage collectionType="home" id={`${locale}/intro`} />
<TeamRow />
<RenderPage collectionType="home" id={`${locale}/work`} />
