---
import { withBasePath } from '~/utils/path'
---

<div class="team-row">
  <figure>
    <img class="no-zoom" src={withBasePath('/team/huawei-fan.jpg')} alt="Huawei Fan" />
    <figcaption>
      <span>Huawei Fan</span>
      <a
        class="team-github"
        href="https://github.com/Phil-Fan"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Huawei Fan on GitHub"
      >
        <span class="i-ri-github-fill" aria-hidden="true" />
      </a>
    </figcaption>
  </figure>
  <figure>
    <img class="no-zoom" src={withBasePath('/team/qiyuan-chen.jpg')} alt="Qiyuan Chen" />
    <figcaption>
      <span>Qiyuan Chen</span>
      <a
        class="team-github"
        href="https://github.com/qychen2001"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Qiyuan Chen on GitHub"
      >
        <span class="i-ri-github-fill" aria-hidden="true" />
      </a>
    </figcaption>
  </figure>
  <figure>
    <img class="no-zoom" src={withBasePath('/team/jiahe-chen.jpg')} alt="Jiahe Chen" />
    <figcaption>
      <span>Jiahe Chen</span>
      <a
        class="team-github"
        href="https://github.com/JiaheChen2002"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Jiahe Chen on GitHub"
      >
        <span class="i-ri-github-fill" aria-hidden="true" />
      </a>
    </figcaption>
  </figure>
  <figure>
    <img class="no-zoom" src={withBasePath('/team/junhao-zhuo.jpg')} alt="Junhao Zhuo" />
    <figcaption>
      <span>Junhao Zhuo</span>
      <a
        class="team-github"
        href="https://github.com/ffy6511"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Junhao Zhuo on GitHub"
      >
        <span class="i-ri-github-fill" aria-hidden="true" />
      </a>
    </figcaption>
  </figure>
</div>
