<style>
  .logo-container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;

    transform: scale(1.05);
  }

  @media (max-width: 767.9px) {
    .logo-container {
      margin-top: 0.125rem;

      transform-origin: 0%;
      transform: scale(0.95);
    }
  }
</style>

<style is:inline>
  .logo-svg {
    height: 2rem;
    width: auto;
    color: #17191e;
  }

  .dark .logo-svg {
    color: #fdfdfd;
  }

  .logo-draw {
    animation: logo-write var(--dur) cubic-bezier(0.4, 0, 0.2, 1) var(--delay) both;
  }

  @keyframes logo-write {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce), print {
    .logo-draw {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
