---
import Link from '~/components/base/Link.astro'
import { localeFromPathname, t } from '~/i18n'
import { withBasePath } from '~/utils/path'

interface Props {
  class?: string
}

const { class: className } = Astro.props
const locale = localeFromPathname(Astro.url.pathname)
---

<Link
  class:list={['op-transition', className]}
  href={withBasePath('/rss.xml')}
  title={t(locale, 'rss')}
  external={true}
>
  <div u-i-lucide-rss></div>
</Link>
