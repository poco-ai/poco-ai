---
import BaseLayout from '~/layouts/BaseLayout.astro'
import StandardLayout from '~/layouts/StandardLayout.astro'
import HomeColumn from '~/components/views/HomeColumn.astro'
import { t } from '~/i18n'

const title = 'Poco'
const description = t('zh', 'pageHomeDescription')
---

<BaseLayout title={title} description={description} bgType="plum" ogImage={true}>
  <StandardLayout title={title} isWide>
    <div slot="article">
      <HomeColumn locale="zh" />
    </div>
  </StandardLayout>
</BaseLayout>
